# Copy this file to .env and fill in real values. .env is gitignored.

# --- Postgres container (docker-compose) ---
POSTGRES_USER=talaan
POSTGRES_PASSWORD=change-me
POSTGRES_DB=talaan
POSTGRES_PORT=5432

# --- Application database connection ---
# The password here MUST match POSTGRES_PASSWORD above.
# Host is "localhost" when running the API on your machine,
# or the compose service name ("db") when the API also runs in Docker.
DATABASE_URL=postgresql+psycopg2://talaan:change-me@localhost:5432/talaan
